  "template": "<span id=\"relateNews${uid}\">读取内容中,请等待...</span>\n<script language=javascript src=${v_link(\"/system/resource/js/ajax.js\")}></script>\n<script language=javascript src=${v_link(\"/system/resource/js/gallery/relationimage.js\")}></script>\n<script>\nfunction init${uid}()\n{\n    var xmlhttp = createXMLHttpRequest()\n    var url=\"/system/resource/code/pagepicrelatenews.jsp?owner=${owner}\";\n    url+=\"&newsid=${newsId}\";\n    url+=\"&treeid=${treeId}\";\n    url+=\"&mode=${mode}\";\n    url+=\"&pageUrl=${pageUrl}\";\n    url+=\"&strlen=${strlen}\"\n    url+=\"&countsize=${countsize}\"    \n    url+=\"&isshowcurrentcolumn=${isshowcurrentcolumn}\"\n    var rpi = new relationpagepicimage();\n    rpi.uid= \"${uid}\";\n    rpi.sendurl=url;\n    rpi.relateNewsdiv=\"relateNews${uid}\";\n    rpi.show();\n}\ninit${uid}()\n</script>",
