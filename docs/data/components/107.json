  "template": "<script type=\"text/javascript\">\nvar  create_advance_search_conditon = null;\nvar tsites_advance_search = null;\njQuery(document).ready(function(){\n    jQuery.ajax({\n          url: \"/system/resource/tsites/jsviews.min.js\",\n          dataType: \"script\",\n          cache: true\n    }).done(function() {\n        tsites_advance_search = new Tsites_advance_search();\n        if(tsites_load_data_options)\n        {\n            tsites_advance_search.initParam(tsites_load_data_options); \n            tsites_advance_search.setIsBd(${isbd});\n            tsites_advance_search.setIsSd(${issd}); \n            tsites_advance_search.loadData();\n        }\n        create_advance_search_conditon = new Create_advance_search_conditon();\n    });\n});\nfunction Create_advance_search_conditon()\n{\n    var teachername = \"\";\n    var rdvalue = \"\";\n \n    this.setTeacherNameAndRdValue = function()\n    {\n        teachername = jQuery(\"#${teamnameInputId}\").val(); \n        if(teachername==\"关键字\")\n        {\n            teachername = \"\";\n        }\n            rdvalue = jQuery(\"#${reasearchDirection}\").val(); \n        if(rdvalue==\"关键字\")\n        {\n            rdvalue = \"\";\n        } \n    }   \n    this.selectByCollege = function(sobj)\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        var id = sobj?sobj.options[sobj.selectedIndex].value:0; \n        tsites_advance_search.setCollege(id);\n    }\n    this.selectByDiscipline = function(dobj)\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        var id = dobj?dobj.options[dobj.selectedIndex].value:0;\n        tsites_advance_search.setDiscipline(id);\n    }\n    this.selectByEnrollDiscipline = function(dobj)\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        var id = dobj?dobj.options[dobj.selectedIndex].value:0;\n        tsites_advance_search.setEnrollDiscipline(id);\n    }\n    this.selectByRank = function(id,aobj)\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        tsites_advance_search.setRank(id);\n    }\n    this.selectByHonor = function(dobj)\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n    var id = dobj?dobj.options[dobj.selectedIndex].value:0;\n        tsites_advance_search.setHonor(id);\n    }\n    this.selectByPinyin = function(py)\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        tsites_advance_search.setPinyin(py);\n    }\n    this.selectByIsBd = function()\n   {\n        this.setTeacherNameAndRdValue();\n        this.setBdAndSdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        tsites_advance_search.setIsBd(isbd);\n    }\n     this.selectByIsSd = function()\n   {\n        this.setTeacherNameAndRdValue();\n        this.setBdAndSdValue();\n        tsites_advance_search.onlySetTeacherNameAndRd(teachername,rdvalue);\n        tsites_advance_search.setIsSd(issd);\n    }\n    this.selectByNameAndRd = function()\n    {\n        this.setTeacherNameAndRdValue();\n        tsites_advance_search.setTeacherNameAndRd(teachername,rdvalue);\n    }\n    this.reset_select = function()\n    {\n        jQuery(\"#${teamnameInputId}\").val(\"关键字\");\n        jQuery(\"#${reasearchDirection}\").val(\"关键字\"); \n        //学院重置\n        var tc = document.getElementById(\"tsites_teacher_query_college_id\");\n        tc.options[0].selected=true;\n        //学科重置\n        var ttd = document.getElementById(\"tsites_teacher_query_discipline_id\");\n        ttd.options[0].selected=true;\n        //教师职称重置\n        var ttqd = document.getElementById(\"tsites_teacher_query_zs_discipline_id\");\n        ttqd.options[0].selected=true; \n        tsites_advance_search.resetCollege(0);\n        tsites_advance_search.resetDiscipline(0);\n        tsites_advance_search.resetRank(0);\n        tsites_advance_search.onlySetTeacherNameAndRd('','');\n        tsites_advance_search.loadData();   \n    }\n}\n</script>\n<div class=\"search-area clearfix\">\n<div class=\"item\">\n<label for=\"\">学院设置：</label>\n\n<select onchange=\"create_advance_search_conditon.selectByCollege(this)\" id=\"tsites_teacher_query_college_id\" >\n    <option value=\"0\">--不限--</option>\n    <#list collegeList as college>\n        <option value=\"${college.collegeId}\">\n        |--${college.collegeShowName}\n        </option>\n          \n    </#list>\n</select>\n</div>\n\n\n\n\n\n<div class=\"item\">\n<label for=\"\">学科专业：</label>\n<select onchange=\"create_advance_search_conditon.selectByDiscipline(this)\" id=\"tsites_teacher_query_discipline_id\">\n    <option value=\"0\">--不限--</option>\n    <#list disciplineList as discipline>\n        <option value=\"${discipline.disciplineId}\">\n        |--${discipline.disciplineShowName}\n        </option>        \n    </#list>\n</select>\n</div>\n\n\n<div class=\"item\">\n<label for=\"\">研究方向：</label>\n<input id=\"${reasearchDirection}\" name=\"\" type=\"text\" class=\"inpyjf text\" value=\"关键字\" onfocus=\"this.style.color='#000';if (value =='关键字'){value =''}\" onblur=\"this.style.color='#000';if (value ==''){value='关键字'}\"  />\n</div>\n\n\n<div class=\"item\">\n<label for=\"\">教师职称：</label>\n<select onchange=\"create_advance_search_conditon.selectByRank(this.value,this)\" id=\"tsites_teacher_query_zs_discipline_id\">\n    <option value=\"0\">--不限--</option>\n    <#list rankList as rank>\n        <option value=\"${rank.rankId}\">\n        |--${rank.rankShowName}\n        </option>\n    </#list>\n</select>\n</div>\n\n\n<div class=\"item\">\n<label for=\"\">姓氏名称：</label>\n<input id=\"${teamnameInputId}\" name=\"\" type=\"text\" class=\"inpyjf text\" value=\"关键字\" onfocus=\"this.style.color='#000';if (value =='关键字'){value =''}\" onblur=\"this.style.color='#000';if (value ==''){value='关键字'}\"/>\n</div>\n\n\n\n\n\n\n\n<div class=\"submite\">\n           \n                <input value=\"查询\" class=\"sub\" type=\"button\" onclick=\"create_advance_search_conditon.selectByNameAndRd()\" >\n           \n                <input value=\"重置\" class=\"reset\" type=\"button\" onclick=\"create_advance_search_conditon.reset_select()\">\n          \n</div>\n\n</div>\n\n",
