  "template": "<script language=\"javascript\"\n    src=\"${v_link(\"/system/resource/js/newcalendar/WdatePicker.js\")}\"></script>\n<script>\nString.prototype.trim　= function()       \n{              \n    var t = this.replace(/(^\\s*)|(\\s*$)/g, \"\");     \n    return t.replace(/(^　*)|(　*$)/g, \"\");     \n}   \nfunction subsearchdata${formName}()\n{ \n    if(document.${formName}.INTEXT.value.trim()==\"\")\n    {\n        alert(\"请输入查询关键字！\");\n        return false;\n    }\n    if(checkData${formName}(document.${formName}))\n    {\n       return true;  \n    }\n    return false;\n}       \n</script>\n\n<#if isSearchFreqFast>\n    <script language='JavaScript' src='${v_link(\"/system/dwr/engine.js\")}'></script>\n    <script language='JavaScript' src='${v_link(\"/system/dwr/util.js\")}'></script>\n    <script language='JavaScript'\n        src='${v_link(\"/system/dwr/interface/NewsSearchDWR.js\")}'></script>\n    <script language='JavaScript'\n        src='${v_link(\"/system/resource/js/vsb_news_search.js\")}'></script>\n    <script language='JavaScript'\n        src='${v_link(\"/system/resource/js/vsb_news_search_entry.js\")}'></script>                \n    <script language='JavaScript' src='${v_link(\"/system/resource/js/language.js\")}'></script>\n    <script language='JavaScript' src='${v_link(\"/system/resource/js/base64.js\")}'></script>\n    <script language='JavaScript' src='${v_link(\"/system/resource/js/formfunc.js\")}'></script> \n    \n    <script>    \n    news_search${formName} = new vsb_news_search();\n    news_search${formName}.isShowCode=false;\n    news_search${formName}.tooltipid = 'tooltip${formName}';\n    news_search${formName}.apptag = 'intextspan${formName}';\n    news_search${formName}.frametag = 'intextframe${formName}';\n    news_search_entry${formName} = new vsb_news_search_entry();\n    news_search_entry${formName}.formname = \"${formName}\";\n    news_search_entry${formName}.news_search_obj = news_search${formName}; \n    news_search_entry${formName}.querytxtsize = 155\n    news_search_entry${formName}.yzmts =\"您的查询过于频繁，请输入验证码后继续查询\";\n    news_search_entry${formName}.qdstyle =\"\";\n    news_search_entry${formName}.qdname = \"确定\";\n    news_search_entry${formName}.qxstyle = \"\";\n    news_search_entry${formName}.qxname = \"取消\";\n    \n    \n    function checkData${formName}(formname)\n    {    \n        return news_search_entry${formName}.checkdata(formname);   \n    }\n    </script>\n<#else>\n    <script> \n    function checkData${formName}(formname)\n    {\n        if(${formName}.INTEXT.value.trim()==\"\")\n        {\n            alert(\"请输入查询关键字！\");\n            return false;\n        }       \n        var  base64 = new Base64();\n        if(window.toFF==1)\n            {\n                var ssvalue = ${formName}.INTEXT.value;\n                document.${formName}.INTEXT2.value = base64.encode(Simplized(ssvalue));\n            }else\n            document.${formName}.INTEXT2.value = base64.encode(document.${formName}.INTEXT.value);\n           return true;\n    }\n    </script>\n</#if>\n\n<form action=\"${action}\" method=\"post\" name=\"${formName}\" target=\"_blank\" onsubmit=\"return subsearchdata${formName}()\">\n    ${hidden}\n    <table class=\"detailFrame\" width=100% align=\"center\" border=\"0\"\n        cellspacing=\"0\" cellpadding=\"5\"\n        style=\"border-collapse: collapse; border: 0px #FFFFFF solid;\">\n        <tr>\n            <td align=\"right\" nowrap=\"nowrap\" style=\"border: 0px #FFFFFF solid;\">\n                <span style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-SIZE: 9pt;\">关键字：</span>\n            </td>\n            <td align=\"left\">\n                <span id=\"intextspan${formName}\"></span>\n                <iframe id=\"intextframe${formName}\" src=\"about:blank\" scrolling=\"no\"\n                    frameborder=\"0\"\n                    style=\"position: absolute; top: 0px; left: 0px; display: none;\"></iframe>\n                <input type=\"text\" name=\"${inTextName}\" id=\"${inTextName}\" size=20\n                    style=\"height: 20px; width: 170px; COLOR: #222222; FONT-SIZE: 10pt; BORDER-TOP: #878787 1px solid; BORDER-RIGHT: #878787 1px solid; BORDER-LEFT: #878787 1px solid; FONT-FAMILY: 宋体; HEIGHT: 22px; POSITION: relative; PADDING-TOP: 3px; BORDER-BOTTOM: #878787 1px solid;\">\n            </td>\n        </tr>\n        <tr>\n            <td align=\"right\">\n                <span style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-SIZE: 9pt;\">栏&nbsp;&nbsp;目：</span>\n            </td>\n            <td align=\"left\">\n                <select name=\"${navItemName}\"\n                    style=\"width: 170px; COLOR: #222222; FONT-SIZE: 10pt; BORDER-TOP: #878787 1px solid; BORDER-RIGHT: #878787 1px solid; BORDER-LEFT: #878787 1px solid; FONT-FAMILY: 宋体; HEIGHT: 22px; POSITION: relative; PADDING-TOP: 3px; BORDER-BOTTOM: #878787 1px solid;\">\n                    ${navOption}\n                </select>\n            </td>\n        </tr>\n\n        <tr>\n            <td align=\"right\">\n                <span style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-SIZE: 9pt;\">日&nbsp;&nbsp;期：</span>\n            </td>\n            <td align=\"left\">\n                <input type=text class=\"Wdate\" size=\"15\" value=\"${endDateValue} \"\n                    name=${endDateName }  id=${endDateName } readonly\n                    onfocus=\"WdatePicker({maxDate:'#F{$dp.$D(\\'totime\\')}'})\"\n                    style=\"height: 18px; width: 83px; FONT-FAMILY: 宋体; border: 1 solid #BDDBF7; font-size: 9pt;\">\n                <input type=text class=\"Wdate\" size=\"15\" value=\"${startDateValue} \"\n                    name=${startDateName } id=${startDateName } readonly\n                    onfocus=\"WdatePicker({minDate:'#F{$dp.$D(\\'fromtime\\')}'})\"\n                    style=\"height: 18px; width: 83px; FONT-FAMILY: 宋体; border: 1 solid #BDDBF7; font-size: 9pt;\">\n            </td>\n        </tr>\n        <tr>\n            <td valign=\"middle\" align=\"right\">\n                <span style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-SIZE: 9pt;\">\n                    范&nbsp;&nbsp;围：\n                </span>\n            </td>\n            <td valign=\"middle\" align=\"left\">\n                <select name=\"${fieldName}\"\n                    style=\"width: 170px; COLOR: #222222; FONT-SIZE: 10pt; BORDER-TOP: #878787 1px solid; BORDER-RIGHT: #878787 1px solid; BORDER-LEFT: #878787 1px solid; FONT-FAMILY: 宋体; HEIGHT: 22px; POSITION: relative; PADDING-TOP: 3px; BORDER-BOTTOM: #878787 1px solid;\">\n                    ${fieldOption}\n                </select>\n            </td>\n        </tr>\n        <tr>\n            <Td>\n                &nbsp;\n            </Td>\n            <td valign=\"middle\" align=\"left\" style=\"padding-right: 217px\">\n                <input type=\"image\"\n                    src=\"/system/resource/images/research/seach22.gif\"\n                    align=\"absmiddle\" valign=\"bottom\" style=\"cursor: hand\">\n            </td>\n        </tr>\n    </table>\n</form>",
