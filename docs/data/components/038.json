  "template": "<script type=\"text/javascript\">\nfunction checkinputdata${viewid}()\n{\n        encodeinputdata${viewid}(document.getElementById(\"${titleId}\"),document.getElementById(\"${htitleId}\"));\n        encodeinputdata${viewid}(document.getElementById(\"${contentId}\"),document.getElementById(\"${hcontentId}\"));\n        encodeinputdata${viewid}(document.getElementById(\"${kwordId}\"),document.getElementById(\"${hkwordId}\"));\n        encodeinputdata${viewid}(document.getElementById(\"${sumaryId}\"),document.getElementById(\"${hsumaryId}\"));\n        encodeinputdata${viewid}(document.getElementById(\"${authorId}\"),document.getElementById(\"${hauthorId}\"));\n        encodeinputdata${viewid}(document.getElementById(\"${sourceId}\"),document.getElementById(\"${hsourceId}\"));\n        encodeinputdata${viewid}(document.getElementById(\"${columnId}\"),document.getElementById(\"${hcolumnId}\"));\n}\nfunction encodeinputdata${viewid}(showinputobj,inputobj){\n        var keyword = showinputobj.value;\n        if(window.toFF==1)\n        {\n            showinputobj.value = Simplized(keyword );\n        }else\n        {\n            showinputobj.value = keyword;            \n        }\n        var  base64 = new Base64();\n        inputobj.value = base64.encode(showinputobj.value);\n        new VsbFormFunc().disableAutoEnable(showinputobj);\n    } \n</script>\n<form action=\"${actionURL}\" method=\"post\" id=\"${formName}\" name=\"${formName}\" onsubmit=\"return checkinputdata${viewid}();\" style=\"display: inline\">\n ${hidden}\n <table  style=\"FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\"  width=100% align=\"center\" border=\"0\" cellspacing=\"0\" cellpadding=\"3\">\n        <tr>\n            <td >标题</td>\n            <td >\n                <input type=\"text\" name=\"${titleName}\" id=\"${titleId}\" value=\"\"  style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\" >\n            </td>\n        </tr>\n        <tr>\n            <td >正文</td>\n            <td >\n                <input type=\"text\" name=\"${contentName}\" id=\"${contentId}\" value=\"\" style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\"  >\n            </td>\n        </tr>\n        <tr>\n            <td >关键字</td>\n            <td >\n                <input type=\"text\" name=\"${kwordName}\" id=\"${kwordId}\" value=\"\"  style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\" >\n            </td>\n        </tr>\n        <tr>\n            <td >摘要</td>\n            <td >\n                <input type=\"text\" name=\"${sumaryName}\" id=\"${sumaryId}\" value=\"\" style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\"  >\n            </td>\n        </tr>\n        <tr>\n            <td >作者</td>\n            <td >\n                <input type=\"text\" name=\"${authorName}\" id=\"${authorId}\" value=\"\" style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\"  >\n            </td>\n        </tr>\n        <tr>\n            <td >来源</td>\n            <td >\n                <input type=\"text\" name=\"${sourceName}\" id=\"${sourceId}\" value=\"\"  style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\" >\n            </td>\n        </tr>\n        <tr>\n            <td >栏目</td>\n            <td >\n                <input type=\"text\" name=\"${columnName}\" id=\"${columnId}\" value=\"\" style=\"BORDER-BOTTOM: #878787 1px solid;BORDER-LEFT: #878787 1px solid;FONT-FAMILY: 宋体;HEIGHT: 22px;COLOR: #222222;FONT-SIZE: 10pt;BORDER-TOP: #878787 1px solid;BORDER-RIGHT: #878787 1px solid;PADDING-TOP: 3px;\"  >\n            </td>\n        </tr>\n        <tr>\n            <td >日期</td>\n            <td >\n                <input type=text readonly='readonly' name='_w_v_l_s_n_s_k_begin' id=\"fgidate\" class=\"Wdate\" size=22 onfocus=\"WdatePicker({dateFmt:'yyyy-MM-dd HH:mm:ss',maxDate:'#F{$dp.$D(\\'lgidate\\')}'})\" />\n                <input type=text readonly='readonly' name='_w_v_l_s_n_s_k_end' id=\"lgidate\" class=\"Wdate\" size=22 onfocus=\"WdatePicker({dateFmt:'yyyy-MM-dd HH:mm:ss',minDate:'#F{$dp.$D(\\'fgidate\\')}',maxDate:'2030-1-1'})\" />\n            </td>\n        </tr>\n        <tr height=\"30\" >\n            <TD>&nbsp;</TD>\n            <td >\n                <input type=\"image\" src=\"/system/resource/images/research/seach22.gif\" border=\"0\" align=\"absmiddle\" style=\"cursor: pointer;\">\n            </td>\n        </tr>\n    </table>\n</form>\n",
