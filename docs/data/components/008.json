  "template": "<!-- 下面这个div是二维码容器,ID不能变-->\n<div id=\"output${uid}\"></div>\n<!-- 下面是生成二维码调用的JS，不要动-->\n${v_includeJquery()}\n<script src=\"/system/resource/qrcode/js/jquery.qrcode.js\"></script>\n<script src=\"/system/resource/qrcode/js/qrcode.js\"></script>\n<script>\nvar codeInfo = \"${text}\" ==\"\"? window.location.href:\"${text}\";\n<#if elementRunMode == 1>\n    codeInfo = \"https://example.invalid/\";\n</#if>\njQuery(function(){\n    jQuery('#output${uid}').qrcode({\n        text:codeInfo,\n        render: !!document.createElement('canvas').getContext?\"canvas\":\"table\",//设置渲染方式  \n        width: ${width},     //设置宽度  \n        height: ${height},     //设置高度  \n        correctLevel: ${correctlevel},//纠错等级  \n        background: \"${background}\",//背景颜色  \n        foreground: \"${foreground}\",//前景颜色  \n        logo:\"${logo}\"//图像logo\n    });\n})\n</script>",
