  "template": "<#list facultylist as faculty>\n    <p>${faculty.collegename}</p>\n    <ul>\n        <#list faculty.teacherlist as teacher>\n            <li id=\"${teacher.lineID}\" style=\"${teacher.lineShowStyle}\">\n                <em><a href=\"${teacher.url}\"  target=_blank title=\"${teacher.tipName}\">\n                    <table width=\"140\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                        <tbody>\n                            <tr>\n                            <td height=\"170\" align=\"center\" valign=\"middle\">\n                                <img   id=\"${teacher.picId}\"/>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n                </a></em>\n                <span>\n                    <h2><a href=\"${teacher.url}\"  target=_blank title=\"${teacher.tipName}\">${teacher.showName}</a></h2>\n                    <p><font>单位:</font>${teacher.unit}</p>\n                </span>\n            </li>\n         </#list>   \n     </ul>          \n</#list> ",
