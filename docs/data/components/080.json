  "template": "<script type=\"text/javascript\">\n     function checksearch${UUID}()\n     { \n            var keyword = document.getElementById(\"${newsKeyCodeId}\").value \n            if(keyword==null||keyword==\"\")\n            { \n            alert(\"请输入你要检索的内容！\"); \n            return false; \n            } \n            if(window.toFF==1) \n            { \n            document.getElementById(\"lucenegbsearchkeyword${viewid}\").value = Simplized(keyword ); \n            }\n            else \n            { \n            document.getElementById(\"lucenegbsearchkeyword${viewid}\").value = keyword; \n            } \n            var base64 = new Base64(); \n            document.getElementById(\"lucenegbsearchkeyword${viewid}\").value=base64.encode(document.getElementById(\"lucenegbsearchkeyword${viewid}\").value); \n            document.getElementById(\"${newsKeyCodeId}\").disabled=true; return true; \n      } \n</script> \n<form action=\"${actionURL}\" method=\"post\" name=\"${formName}\" onsubmit=\"return checksearch${UUID}()\">\n     ${hidden}\n<table width=\"775\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" class=\"search${uniqueClassName}\">\n  <tr>\n    <td width=\"154\" height=\"52\" align=\"center\" class=\"ss${uniqueClassName}\"><span class=\"search_font${uniqueClassName}\">公众参与全文检索:</span></td>\n    <td width=\"464\" class=\"ss${uniqueClassName}\"><input name=\"${newsKeyCode}\" type=\"text\" class=\"search_input${uniqueClassName}\" id=\"${newsKeyCodeId}\" value=\"${inValue}\"> </td>\n    <td width=\"157\" class=\"ss${uniqueClassName}\"><input type=\"image\" src=\"/system/resource/guestbook/images/btn_gzcrsearch.gif\" name=\"button\" id=\"button\" value=\"提交\" /></td>\n  </tr>\n</table>\n</form>\n<table width=\"775\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\">\n  <tr>\n    <td height=\"20\"></td>\n  </tr>\n</table>\n<#if totleNum!=0 > \n<form action=\"${actionURL}\" method=\"post\"> \n<#list resultList as list> \n<table width=\"775\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" class=\"info_boder${uniqueClassName}\">\n  <tr>\n    <td height=\"187\" valign=\"top\">\n        <table width=\"94%\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" >\n      <tr>\n        <td width=\"40\" align=\"center\"><img src=\"/system/resource/guestbook/images/ico_tj.gif\" width=\"17\" height=\"17\" /></td>\n        <td class=\"info_title${uniqueClassName}\"><a href=\"${list.url}\" style=\"TEXT-DECORATION: none\"><span class=\"info_title${uniqueClassName}\">${list.title}</span></a></td>\n      </tr>\n      <tr>\n        <td>&nbsp;</td>\n        <td class=\"info_content${uniqueClassName}\">${list.content}</td>\n      </tr>\n      <tr>\n        <td>&nbsp;</td>\n        <td align=\"right\" class=\"info_time${uniqueClassName}\">提交时间：${list.time}</td>\n      </tr>\n    </table>\n      <table width=\"94%\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td height=\"20\"><hr style=\"color:#cccccc;height:1px;border:0px;border-top:1px dashed #cccccc;margin:0px;padding:0px;overflow:hidden\"/></td>\n        </tr>\n      </table>\n    <table width=\"94%\" border=\"0\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td width=\"40\" align=\"center\"><img src=\"/system/resource/guestbook/images/ico_huifu.gif\" width=\"17\" height=\"16\" /></td>\n        <td class=\"info_title${uniqueClassName}\">回复内容：</td>\n      </tr>\n      <tr>\n        <td>&nbsp;</td>\n        <td class=\"info_content${uniqueClassName}\">${list.reContent}</td>\n      </tr>\n      <tr>\n        <td>&nbsp;</td>\n        <td align=\"right\" class=\"info_time${uniqueClassName}\">回复部门：${list.deptName}   　　 回复时间：${list.reTime}</td>\n      </tr>\n  </table>\n    </td>\n  </tr>\n</table>\n</#list> \n<#if number<totleNum > \n<table cellspacing=1 cellpadding=0 border=0 width=\"100%\"> \n    <tr> \n        <td align=\"center\"> \n            共有 ${totleNum} 条&nbsp;&nbsp; <#if 1<currentPage><a href=\"${firstPageUrl}\"> 首页</a><#else> 首页</#if> &nbsp;&nbsp;&nbsp;&nbsp; \n            <#if 1<currentPage ><a href=\"${priUrl}\">上一页</a><#else>上一页</#if>&nbsp;&nbsp;&nbsp;&nbsp; \n            <#if currentPage<totlePages ><a href=\"${nextUrl}\">下一页</a><#else>下一页</#if>&nbsp;&nbsp;&nbsp;&nbsp; \n            <#if currentPage<totlePages ><a href=\"${lastPageUrl}\">尾页</a><#else>尾页</#if>&nbsp;&nbsp; \n            共有 ${totlePages} 页&nbsp;&nbsp; 当前第 ${currentPage} 页 \n        </td> \n    </tr> \n</table> \n</#if> \n<#else> \n<table style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\" cellspacing=1 cellpadding=0 border=0 width=\"100%\"> \n<tr> <td> 找不到和您的查询&nbsp;\" <B> ${inValue} </B> \" &nbsp;相符的新闻。 <br> <br> </td> </tr> \n<tr> <td> 建议: </td> </tr> <tr> <td> \n<ul> &nbsp;&nbsp;&nbsp;&nbsp; \n<li> 请检查输入字词有无错误。 &nbsp;&nbsp;&nbsp;&nbsp; \n<li> 请换用另外的查询字词。 &nbsp;&nbsp;&nbsp;&nbsp; \n<li> 请改用较常见的字词。 \n</ul> \n</td> \n</tr> \n</table> \n</form>\n</#if> ",
