  "template": "<script type=\"text/javascript\">\n    function _leadermail_search_changebase64_1()\n    {\n       if(document.getElementById(\"${wbserialnum}_temp\"))\n       {\n           var s_t = document.getElementById(\"${wbserialnum}_temp\").value;\n           if(s_t==null||s_t==\"\"||s_t==undefined)\n           {\n                alert(\"请输入流水号\");\n                document.getElementById(\"${wbserialnum}_temp\").focus();\n                return false;\n           } \n       } \n       if(document.getElementById(\"${wbsearchcode}_temp\"))\n       {\n           var s_t = document.getElementById(\"${wbsearchcode}_temp\").value;\n           if(s_t==null||s_t==\"\"||s_t==undefined)\n           {\n                alert(\"请输入查询密码\");\n                document.getElementById(\"${wbsearchcode}_temp\").focus();\n                return false;\n           } \n       } \n       if(document.getElementById(\"${wbserialnum}_temp\"))\n       {\n           document.getElementById(\"${wbserialnum}\").value=new  Base64().encode(document.getElementById(\"${wbserialnum}_temp\").value);\n           document.getElementById(\"${wbserialnum}_temp\").disabled=true;\n       }\n       if(document.getElementById(\"${wbsearchcode}_temp\"))\n       {\n           document.getElementById(\"${wbsearchcode}\").value=new  Base64().encode(document.getElementById(\"${wbsearchcode}_temp\").value);\n           document.getElementById(\"${wbsearchcode}_temp\").disabled=true;\n       }\n       return true;\n    }\n</script>\n<form  name=\"${formname}\" method=\"post\" action=${action} style=\"display: inline;\" onsubmit=\"return _leadermail_search_changebase64_1();\">\n<table>\n    <tr>\n       <td nowrap=\"nowrap\">\n            <span style='FONT-FAMILY: 宋体; FONT-SIZE: 9pt'>流水号：</span><input type=\"hidden\" name=\"${wbserialnum}\" id=\"${wbserialnum}\"  ><input type=\"text\" name=\"${wbserialnum}_temp\" id=\"${wbserialnum}_temp\"  style=\"width:100px;BORDER-BOTTOM: #d2eec6 1px solid;BORDER-LEFT: #d2eec6 1px solid;FONT-FAMILY: 宋体;HEIGHT: 12pt;FONT-SIZE: 9pt;BORDER-TOP: #d2eec6 1px solid;BORDER-RIGHT: #d2eec6 1px solid; \" >\n        </td>\n        <td nowrap=\"nowrap\">\n            <span style='FONT-FAMILY: 宋体; FONT-SIZE: 9pt'>查询密码：</span><input type=\"hidden\" name=\"${wbsearchcode}\" id=\"${wbsearchcode}\" ><input type=\"text\" name=\"${wbsearchcode}_temp\" id=\"${wbsearchcode}_temp\"   style=\"width:100px;BORDER-BOTTOM: #d2eec6 1px solid;BORDER-LEFT: #d2eec6 1px solid;FONT-FAMILY: 宋体;HEIGHT: 12pt;FONT-SIZE: 9pt;BORDER-TOP: #d2eec6 1px solid;BORDER-RIGHT: #d2eec6 1px solid; \" >\n        </td>\n        <td align=\"absmiddle\"><input type=\"image\"  src=\"/system/resource/images/leadermail/anniu_cx2.jpg\" valign=\"bottom\" style=\"cursor:hand\"></td>\n    </tr>\n</table>\n</form>",
