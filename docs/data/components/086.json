  "template": "<div class=\"govitemcontent${uniqueClassName}\">\n    <TABLE style=\"FONT-SIZE: 9pt; COLOR: #6f6f6f; FONT-FAMILY: 宋体;word-break:break-all\" cellspacing=\"0\" cellpadding=\"5\" width=\"100%\" border=\"0\" >\n        <tr style=\"BACKGROUND-IMAGE: url(/system/resource/images/leadermail/ldxx_list_topbg.gif); POSITION: relative; FONT-FAMILY: 宋体; HEIGHT: 32px; COLOR: #ff6600; FONT-SIZE: 9pt; FONT-WEIGHT: bold\" >\n            <td align=\"center\">标题</td>\n            <td align=\"center\">时间</td>\n            <td align=\"center\">回复状态</td>\n        </tr>\n        <#list list_item as list>\n        <TR <#if list.isEven >style=\" BACKGROUND-COLOR: #fff9e7\"</#if> align=\"center\" >\n            <TD align=\"left\" nowrap=\"nowrap\"   style=\"padding-left:30px\">\n                <a href=\"${list.titleURL}\" style=\"text-decoration: none;\" >\n                <span  style=\"cursor: hand;FONT-SIZE: 9pt; COLOR: #6f6f6f; FONT-FAMILY: 宋体; POSITION: relative; TEXT-DECORATION: none\">\n                ${list.showTitle}\n                </span> </a>\n            </TD>\n            <TD align=\"center\" nowrap=\"nowrap\"  >\n                ${list.showTime}\n            </TD>\n            <TD align=\"center\" nowrap=\"nowrap\"  >\n                <span style=\"FONT-SIZE: 9pt; COLOR: #ff6600; FONT-FAMILY: 宋体\">\n                    <#if list.reply==\"0\">没有回复<#else>已经回复</#if>\n                </span>\n            </TD>\n        </tr>\n      </#list>\n    </TABLE>\n</div>",
