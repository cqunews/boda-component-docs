  "template": "<#if mailId!=0 >\n    <div class=\"govitemcontentdetal${uniqueClassName}\">\n <TABLE style=\"FONT-SIZE: 9pt; FONT-FAMILY: 宋体\" cellspacing=\"0\" cellpadding=\"8\" width=\"100%\" style=\"word-break:break-all\">\n            <tr>\n                <td colspan=\"4\"  style=\"FONT-FAMILY: 宋体;FONT-SIZE: 18pt;FONT-WEIGHT: bold;\" ><img src=\"/system/resource/images/default/bltj_08.jpg\" border=\"0\" align=\"absmiddle\">信件内容</td>\n            </tr> \n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\" nowrap  width=\"10%\">流水号</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${serialnum}</td>\n            </tr>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">标&nbsp;&nbsp;&nbsp;&nbsp;题</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${title}</td>\n            </tr>\n            <#if showname>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">姓&nbsp;&nbsp;&nbsp;&nbsp;名</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${name}</td>\n            </tr>\n            </#if>\n            <#if showsex>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">性&nbsp;&nbsp;&nbsp;&nbsp;别</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${sex}</td>\n            </tr>\n            </#if>\n            <#if showage>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">年&nbsp;&nbsp;&nbsp;&nbsp;龄</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" ><#if (age>0) > ${age} </#if></td>\n            </tr>\n            </#if>\n            <#if showphone>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">固定电话</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${phone}</td>\n            </tr>\n            </#if>\n            <#if showmobile>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">手&nbsp;&nbsp;&nbsp;&nbsp;机</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${mobile}</td>\n            </tr>\n            </#if>\n            <#if showaddress>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">地&nbsp;&nbsp;&nbsp;&nbsp;址</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${address}</td>\n            </tr>\n            </#if>\n            <#if showemail>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">邮&nbsp;&nbsp;&nbsp;&nbsp;箱</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${email}</td>\n            </tr>\n            </#if>\n            <#if showpost>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">邮政编码</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${post}</td>\n            </tr>\n            </#if>\n            <#if showidcard>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">身份证号</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${idcard}</td>\n            </tr>\n            </#if>\n            <#if showidentity>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">身&nbsp;&nbsp;&nbsp;&nbsp;份</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FONT-SIZE: 9pt;TEXT-DECORATION: none;text-align: left;\"  colspan=\"3\" >${identity}</td>\n            </tr>\n            </#if>\n            <#if showjob>\n            <tr>\n                <td  style=\"PADDING-LEFT: 25px;FONT-WEIGHT: bold;FONT-SIZE: 9pt;COLOR: #ff6600;FONT-FAMILY: 宋体;BACKGROUND-COLOR: #ffffec;text-align: left;\"  nowrap  width=\"10%\">职&nbsp;&nbsp;&nbsp;&nbsp;务</td>\n                <td  style=\"FONT-FAMILY: 宋体;COLOR: #5e5e5e;FON