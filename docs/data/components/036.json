  "template": "<script type=\"text/javascript\">\nfunction checksearch${uid}(type){\n        var keyword = document.getElementById('_w_v_l_s_n_s_kword_show_id${uid}').value;\n        if(keyword==null||keyword==\"\"){\n            alert(\"请输入查询内容\");\n            return false;\n        }\n        if(window.toFF==1)\n        {\n            document.getElementById(\"_w_v_l_s_n_s_kword_show_id${uid}\").value = Simplized(keyword );\n        }else\n        {\n            document.getElementById(\"_w_v_l_s_n_s_kword_show_id${uid}\").value = keyword;            \n        }\n        var  base64 = new Base64();\n        document.getElementById(\"_w_v_l_s_n_s_kword_id${uid}\").value = base64.encode(document.getElementById(\"_w_v_l_s_n_s_kword_show_id${uid}\").value);\n        new VsbFormFunc().disableAutoEnable(document.getElementById(\"_w_v_l_s_n_s_kword_show_id${uid}\"));\n        return true;\n    } \n</script>\n<form action=\"${actionURL}\" method=\"post\" id=\"${formName}\" name=\"${formName}\" onsubmit=\"return checksearch${uid}(1)\" target=\"_blank\" style=\"display: inline\">\n    <input type=\"hidden\" id=\"_w_v_l_s_n_s_kword_id${uid}\"  name=\"_w_v_l_s_n_s_k\" value=\"\">\n    <input type=\"hidden\" id=\"searchScope\" name=\"searchScope\" value=\"${searchScope}\">\n    <table   width=100% align=\"center\" border=\"0\" cellspacing=\"1\" cellpadding=\"3\">\n        <tr class=\"listTitle\">\n            <td align=\"left\"  nowrap=\"nowrap\" style=\"FONT-FAMILY: 宋体; FONT-SIZE: 9pt\">\n                文章检索：\n                <input type=\"text\" name=\"_w_v_l_s_n_s_kword_show\" id=\"_w_v_l_s_n_s_kword_show_id${uid}\" value=\"${keyword}\"  style=\"BACKGROUND-IMAGE: url(${v_link(\"/system/resource/images/research/seach_bg.gif\")}); BORDER-BOTTOM: #878787 1px solid; POSITION: relative; BORDER-LEFT: #878787 1px solid; PADDING-LEFT: 18px; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: 宋体; HEIGHT: 22px; COLOR: #222222; FONT-SIZE: 10pt; BORDER-TOP: #878787 1px solid; BORDER-RIGHT: #878787 1px solid; PADDING-TOP: 3px\">\n                <select name=\"${searchTypeName}\" id=\"_w_v_l_s_n_s_kstype_id\" >\n                    <option value=\"1\" <#if type==1 >selected</#if> >\n                                            全部\n                    </option>\n                    <option value=\"2\" <#if type==2 >selected</#if>>\n                        标题\n                    </option>\n                    <option value=\"3\" <#if type==3 >selected</#if>>\n                                             正文\n                    </option>\n                    <option value=\"4\" <#if type==4 >selected</#if>>\n                        标签\n                    </option>\n                    <option value=\"5\" <#if type==5 >selected</#if>>\n                                        摘要\n                    </option>\n                    <option value=\"6\" <#if type==6 >selected</#if>>\n                                        作者\n                    </option>\n                    <option value=\"7\" <#if type==7 >selected</#if>>\n                                        来源\n                    </option>\n                    <option value=\"8\" <#if type==8 >selected</#if>>\n                        栏目\n                    </option>\n                </select>\n                <select name=\"${searchTypeTimeName}\" id=\"_w_v_l_s_n_s_kstime_id\" >\n                    <option value=\"0\" <#if time==0 >selected</#if> >\n                        全部时间\n                    </option>\n                    <#list timeList as x>\n                    <option value=\"${x?number}\" <#if time==x?number>selected</#if> >${x}</option>\n                    </#list>\n                </select>\n                <INPUT style=\"CURSOR: hand\" align=absMiddle src=\"/system/resource/images/research/seach22.gif\" type=image>\n            </td>\n        </tr>\n    </table>\n</form>",
