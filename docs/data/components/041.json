  "template": "<form name=\"${formname}\" method=\"post\" id=\"${formname}\" style=\"display:inline;\"  enctype=\"multipart/form-data\">\n    <input type='hidden' name='${actiontypestr}' id=\"${actiontypestr}\">\n    <input type='hidden' name='wbsummary' id=\"wbsummary\">\n    <input type='hidden' name='wbsummary_temp' id=\"wbsummary_temp\">\n    ${storageInputHidden}\n    ${treeidHidden}\n    ${filesumHidden}\n    ${uploadpathHidden}\n    ${statusdiv}\n\n    <DIV ID=_online_Div style=\"display:none\"></DIV>\n    <div class=\"tgcontent${viewid}\" id=\"tgcontent${viewid}\">\n    <table width= height= border=0>\n         <tr>\n            <td colspan=4 style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">\n                <b>欢迎你的来稿，来稿要经过我们的审核才可以通过，请仔细填写，带*号的为必填项。</b>\n            </td>\n         </tr>\n         <tr>\n            <td valign=\"middle\"  width=\"80\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">投稿标题：</td>\n            <td valign=\"middle\"><span style=\"color:#FF8000\">*</span></td>\n            <td valign=\"middle\" colspan=2><input name='${title}' id='${title}' style=\"display: none;\" value=\"\" size='45'><input name='${title}_temp' id='${title}_temp' value=\"\" size='45'></td>\n         </tr>\n         <tr>\n            <td valign=\"middle\"  width=\"80\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">你的名字：</td>\n            <td valign=\"middle\" >&nbsp;</td>\n            <td valign=\"middle\" colspan=2><input type='text' name='${author}' id=\"${author}\" style=\"display: none;\" value=\"\" size='45'><input type='text' name='${author}_temp' id=\"${author}_temp\" value=\"\" size='45'></td>\n         </tr>\n         <tr>\n            <td valign=\"middle\"  width=\"80\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">关&nbsp;键&nbsp;字：</td>\n            <td valign=\"middle\"><span style=\"color:#FF8000\">*</span></td>\n            <td valign=\"middle\"><input  name=\"${keyword}\" id=\"${keyword}\" value=\"\" style=\"display: none;\" size='45'><input  name=\"${keyword}_temp\" id=\"${keyword}_temp\" value=\"\" size='45'></td>\n            <td valign=\"middle\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">\n            <a href=\"javascript:getKeyWord();\" style=\"color:#5E5E5E;text-decoration:none\" id=\"${keyworda}\" title=\"从标题中提取关键字\">[根据标题生成]</a>&nbsp;&nbsp;&nbsp;</td>\n         </tr>\n         <tr>\n            <td valign=\"middle\"  width=\"80\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">投稿栏目：</td>\n            <td valign=\"middle\"><span style=\"color:#FF8000\">*</span></td>\n            <td valign=\"middle\" colspan=2>\n                <select name=${contentid } id=${contentid} size='6'  style='width:306;'>\n                    <#list treelist as tree>\n                        <option value=${tree.treeid}>${tree.postion}</option>\n                    </#list>\n                </select>&nbsp;&nbsp;&nbsp;\n            </td>\n         </tr>\n         <tr>\n            <td colspan=\"4\"  style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">投稿内容：&nbsp;<span style=\"color:#FF8000\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">*(请认真填写投稿内容)</span></td>\n         </tr>\n         <tr>\n            <td colspan=\"4\" >\n                <textarea style=\"width:400px;display:none\" name=${content} id=\"${content}\"></textarea><textarea style=\"width:400px;height:400px;display:none\" name=\"${content}_temp\" id=\"${content}_temp\"></textarea>\n            </td>\n         </tr>\n         <tr>\n            <td colspan=4><input type=\"button\" name=\"button\" value=\"添加附件\" onclick=\"addFiles()\" ${diskfullvalue}>&nbsp;<input type=\"button\" name=\"button\" value=\"删除附件\" onclick=\"deleteInput()\" ${diskfullvalue}>&nbsp;&nbsp;&nbsp;(只允许上传rar,zip,doc,docx,xls,xlsx,jpg,gif格式的文件)</td>\n        </tr>\n        <tr>\n            <td valign=\"middle\" width=\"80\">上传附件：</td>\n            <td valign=\"middle\" >&nbsp;</td>\n            <td valign=\"middle\" colspan=2><span id=\"uploadfiles\"><input type=\"file\" name=\"wordfile\" id=\"wordfile\"  onchange=\"addWordFile(this);\" ${diskfullvalue}><input type='hidden' name='uploadfileurl' id=\"uploadfileurl\" value=''></span></td>\n        </tr>\n         <tr>\n            <td colspan=4>\n                <table>\n                    <tr>\n                        <td  style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">验证码：&nbsp;</td>\n                        <td valign=\"middle\"><input name=${yanzheng } id=${yanzheng} value=\"\" size=\"6\" maxlength=\"4\"></td>\n                        <td valign=\"middle\"><img id=${yanzhengma } name=${yanzhengma } border=\"1\" src=${yanzhengsrc} /></td>\n                        <td valign=\"middle\"><a href=\"javascript:reloadcode();\" style=\"color:#5E5E5E;text-decoration:none\" style=\"TEXT-DECORATION: none;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">[看不清楚,换一个验证码!]</a></td>\n                    </tr>\n                </table>\n            </td>\n         </tr>\n         <tr>\n            <td colspan=4 align=center height=\"35\">\n                <input type=image src=\"/system/resource/images/message/TG.jpg\" style=\"cursor:pointer\" onclick=\"return check${formname}();\">\n            </td>\n         </tr>\n    </table>\n    </div>\n</form>\n<script>\nvar editor;\nKindEditor.ready(function(K) {\n        editor = K.create('#${content}_temp', {\n            resizeType : 2,\n            uploadJson : '/system/resource/kindeditor/plugins/image/uploadfile.jsp',\n            fileManagerJson : '/system/resource/kindeditor/plugins/image/filelist.jsp',\n            allowFileManager : true\n        });\n    });\nvar filename = \"wordfile\";\nvar filespanname = \"spanfile\";\nvar i=1;\nfunction getSummary(len)\n{\n    var _online_Div = document.getElementById(\"_online_Div\");\n    _online_Div.innerHTML = editor.html();\n\n    var str = editor.html();\n    document.getElementById(\"wbsummary_temp\").value = filterEnterStr(fixstringlen(str, len * 2));\n}\nfunction filterEnterStr(strHtml)\n{\n    strHtml = strHtml.replace(/[\\r\\n]/g,\"\");\n    return strHtml;\n}\nfunction check${formname}()\n{\n    var wbtitle = document.getElementById(\"${title}_temp\").value;\n    if(trim(wbtitle)=='')\n    {\n        alert('投稿标题不能为空！');\n        return false;\n    }\n    var wbkeyword = document.getElementById(\"${keyword}_temp\").value;\n    if(wbkeyword=='')\n    {\n        alert('投稿关键字不能为空！');\n        return false;\n    }\n    var wbcontentid = document.getElementById(\"${contentid}\").value;\n    if(wbcontentid=='')\n    {\n        alert('必须选择投稿所属栏目！');\n        return false;\n    }\n    if(trim(editor.html()) == \"\")\n    {\n        alert('投稿内容不能为空！');\n        return false;\n    }\n    var _online_Div = document.getElementById(\"_online_Div\");\n    _online_Div.innerHTML = editor.html();\n\n    var yanzheng = document.getElementById(\"${yanzheng}\").value;\n    if(yanzheng=='')\n    {\n        alert('必须填写验证码！');\n        return false;\n    }\n    document.getElementById(\"${actiontypestr}\").value = \"tj\";  \n    if(yanzheng!='')\n    {\n        Contribute.getRand(yanzheng,callbackdata);\n        return false;\n    }\n}\nfunction callbackdata(data)\n{\n    if(data==false)\n    {\n        alert('验证码错误！');\n    }else\n    {\n        getSummary(200);\n        if(document.getElementById(\"${title}_temp\"))\n        {\n            document.getElementById(\"${title}\").value=new  Base64().encode(document.getElementById(\"${title}_temp\").value);\n            document.getElementById(\"${title}_temp\").disabled=true;\n        }\n        if(document.getElementById(\"${author}_temp\"))\n        {\n            document.getElementById(\"${author}\").value=new  Base64().encode(document.getElementById(\"${author}_temp\").value);\n            document.getElementById(\"${author}_temp\").disabled=true;\n        }\n        if(document.getElementById(\"${keyword}_temp\"))\n        {\n            document.getElementById(\"${keyword}\").value=new  Base64().encode(document.getElementById(\"${keyword}_temp\").value);\n            document.getElementById(\"${keyword}_temp\").disabled=true;\n        }\n        if(document.getElementById(\"${content}_temp\"))\n        {\n            document.getElementById(\"${content}\").value=new  Base64().encode(editor.html());\n            document.getElementById(\"${content}_temp\").disabled=true;\n        }\n        if(document.getElementById(\"wbsummary_temp\"))\n        {\n            document.getElementById(\"wbsummary\").value=new  Base64().encode(document.getElementById(\"wbsummary_temp\").value);\n            document.getElementById(\"wbsummary_temp\").disabled=true;\n        }\n\n        if(data==false)\n        {\n            alert('${noaudittitle}');\n        }else\n        {\n            getSummary(200);\n            if(document.getElementById(\"wbsummary_temp\"))\n            {\n                document.getElementById(\"wbsummary\").value=new  Base64().encode(document.getElementById(\"wbsummary_temp\").value);\n                document.getElementById(\"wbsummary_temp\").disabled=true;\n            }\n            ${formname}.action=\"${actionurl}&filesum=\"+i+\"&yanzheng=\"+document.getElementById(\"yanzheng\").value+\"&actiontypestr=\"+document.${formname}.actiontypestr.value;\n            document.getElementById(\"filesum\").value = i;\n            <#if (storageIsOpen==\"true\")>\n                var obj = document.getElementById(\"uploadfileurl\");\n                if(obj&&obj.value!=null&&obj.value!=\"\"&&obj.value.length>0)\n                {\n                    //启动云存储调用\n                    storage.startStatusCheck();\n                    handleshow();\n                }\n            </#if>\n            document.getElementById(\"${formname}\").submit();\n        }\n    }\n}\nfunction reloadcode()\n{\n    var verify=document.getElementById('${yanzhengma}');\n    verify.setAttribute('src