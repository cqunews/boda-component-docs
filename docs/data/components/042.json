  "template": "<table  align=\"center\" width=\"400\" height=\"200\" cellpadding=\"3\" cellspacing=\"1\" bordercolor=\"#DDEEFF\" border=\"0\">\n    <#list list_job as list>\n    <tr>\n        <td  bgcolor=\"#DDEEFF\"  style=\"font-size:9pt;color:#000000;\" align=\"center\" width=\"16%\">\n            招聘职位\n        </td>\n        <td  style=\"font-size:9pt;color:#000000;\" width=\"35%\">\n            ${list.jobname}\n        </td>\n        <td  bgcolor=\"#DDEEFF\"  style=\"font-size:9pt;color:#000000;\" align=\"center\" width=\"16%\">\n            招聘部门\n        </td>\n        <td  colspan=\"4\" style=\"font-size:9pt;color:#000000;\"  >\n            ${list.departname}\n        </td>\n    </tr>\n    <tr>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            发布日期\n        </td>\n        <td style=\"font-size:9pt;color:#000000;\" >\n            ${list.showreleasedate}\n        </td>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            失效日期\n        </td>\n        <td colspan=\"4\" style=\"font-size:9pt;color:#000000;\" >\n            ${list.showinvdate}\n        </td>\n      </tr>\n      <tr>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            工作地点\n        </td>\n        <td style=\"font-size:9pt;color:#000000;\" >\n            ${list.jobplace}\n        </td>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            联系方式\n        </td>\n        <td colspan=\"4\" style=\"font-size:9pt;color:#000000;\">\n            ${list.contactmode}\n        </td>\n      </tr>\n      <tr>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            薪资待遇\n        </td>\n        <td style=\"font-size:9pt;color:#000000;\" colspan=\"6\">\n            ${list.salary}\n        </td>\n      </tr>\n      <tr >\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            工作职责\n        </td>\n        <td style=\"font-size:9pt;color:#000000;\" colspan=\"6\">\n            ${list.showdescription}\n        </td>\n      </tr>\n      <tr>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\"> \n            职位要求\n        </td>\n        <td style=\"font-size:9pt;color:#000000;\" colspan=\"6\">\n            ${list.showqualification}\n        </td>\n      </tr>                                                                                                                  \n      <tr>\n        <td bgcolor=\"#DDEEFF\" style=\"font-size:9pt;color:#000000;\" align=\"center\">\n            备注\n        </td>\n        <td style=\"font-size:9pt;color:#000000;\" colspan=\"6\">\n            ${list.showremark}\n        </td>\n      </tr> \n      <tr>\n        <td  bgcolor=\"#DDEEFF\" align=\"right\"  colspan=\"8\">\n            <a  style='font-size: 9pt' href =\"mailto:${mailcontent}\">发送邮件</a>\n            <a href = ${list.linkurl} style=\"font-size: 9pt\">申请职位</a>\n        </td>\n      </tr>\n      <#if !list.isLast>\n        <tr>\n            <td colspan=\"8\">\n                <hr color=\"#DDEEFF\" size=\"5\" width=\"400\"/>\n            </td>\n        </tr>\n      </#if>\n    </#list>\n</table>",
