  "template": "<#if searchcode==''>\n    <table><tr><td style=\"font-size: 9pt;\" align=\"center\">请输入查询码!</td></tr></table>\n<#else>\n    <form name=\"${formName}\" method=\"post\" action=\"${actionUrl}\" style=\"display: inline;\">\n        <table style=\"FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\" align=\"center\">\n            <tr>\n                <td>\n                    查询码：&nbsp;<input type=\"text\" name=\"${formSearch}\" value=\"${searchcode}\" style=\"width: 150px\">\n                </td>\n                <td align=\"absmiddle\">\n                    <img src=\"/system/resource/images/default/anniu_cx2.jpg\" valign=\"bottom\" style=\"cursor:hand\" onClick=\"document.${formName}.submit()\">\n                </td>\n            </tr>\n        </table>\n    </form>\n    <#if statue=='1'>\n        <TABLE width=\"100%\" style=\"font-size: 9pt;\" >\n            <tr><td align=\"center\">没有找到你要查询的内容</td></tr>\n        </TABLE>\n    <#else>\n        <table width=\"100%\" border=\"0\"  style=\"word-wrap: break-word;word-break:break-all;border-collapse:collapse;border:1px #ecc197 solid;FONT-FAMILY: 宋体;FONT-SIZE: 9pt;\">\n            <tr>\n                <td width=\"117px\" align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                    标题\n                </td>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                    ${showTitle}\n                </td>\n            </tr>\n            <tr>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                    发言人帐号\n                </td>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                    ${showAccount}\n                </td>\n            </tr>\n            <tr>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                    留言日期\n                </td>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                    ${showTime}\n                </td>\n            </tr>\n            <#if showName!=''>\n                <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        联系人姓名\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showName}\n                    </td>\n                </tr>    \n            </#if>\n            <#if showIdCard!=''>\n                <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        身份证号\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showIdCard}\n                    </td>\n                </tr>\n            </#if>\n            <#if showTelphone!=''>\n                <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        手机\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showTelphone}\n                    </td>\n                </tr>\n            </#if>\n            <#if showAddress!=''>\n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        联系方式\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showAddress}\n                    </td>\n                </tr> \n            </#if>\n            <#if showPhone!=''>\n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        固定电话\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showPhone}\n                    </td>\n                </tr> \n            </#if>\n            <#if showEmail!=''>    \n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        留言人Email\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showEmail}\n                    </td>\n                </tr> \n            </#if>\n            <#if showUnit!=''>         \n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        留言人单位\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showUnit}\n                    </td>\n                </tr>\n            </#if>\n            <#if showSex!=''>   \n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        性别\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showSex}\n                    </td>\n                </tr>\n            </#if>     \n            <tr>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                    处理状态\n                </td>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                   ${showAudit}\n                </td>\n            </tr>\n            <#if (attachSize>0)>\n                <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        附件\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        <#list list_attach as attach>\n                            <a href=\"${attach.downloadUrl}\">${attach.fileName}</a><br>\n                        </#list>\n                    </td>\n                </tr> \n            </#if>\n            <tr>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                    发言内容\n                </td>\n                <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                    ${showContent}\n                </td>\n            </tr>\n            <#if showReaccount!=''>   \n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        回复人名称\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showReaccount}\n                    </td>\n                </tr>\n            </#if>\n            <#if showRetime!=''>   \n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        回复时间\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showRetime}\n                    </td>\n                </tr>\n            </#if>  \n            <#if (reattachSize>0)>\n                <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        回复附件\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        <#list list_reattach as attach>\n                            <a href=\"${attach.downloadUrl}\">${attach.fileName}</a><br>\n                        </#list>\n                    </td>\n                </tr> \n            </#if>\n            <#if showRecontent!=''>   \n                 <tr>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;PADDING-BOTTOM: 5px;PADDING-LEFT: 5px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 5px;FONT-WEIGHT: bold;HEIGHT: 22px;PADDING-TOP: 5px;\">\n                        回复内容\n                    </td>\n                    <td align=\"left\" style=\"border:1px #ecc197 solid;COLOR: #555555;PADDING-LEFT: 15px;LINE-HEIGHT: 2;\">\n                        ${showRecontent}\n                    </td>\n                </tr>\n            </#if>  \n        </table>\n    </#if>\n</#if>",
