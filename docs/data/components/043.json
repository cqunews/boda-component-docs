  "template": "<#--\n    说明：表单项的name必须用给出的参数\n-->\n\n   \n<TABLE align=\"center\"   width=\"650\" height=\"350\" cellpadding=\"2\" cellspacing=\"1\" border=\"0\">    \n<FORM name=${formName} action=\"${actionUrl}\" method=\"post\" onsubmit=\"return _addjob_checkData${uuid}(this)\">    \n    ${engageId} \n    <tr>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">    \n                    姓名   \n            </DIV>    \n        </td>    \n        <td align=\"left\">    \n            <input name=\"${personName}\" id=\"${personName}\" style=\"display: none;\" maxlength=\"10\"><input name=\"${personName}_temp\" id=\"${personName}_temp\" maxlength=\"10\">    \n                <FONT color=\"#FF0000\"> *</FONT>    \n        </td>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">性别</DIV>    \n        </td>    \n        <td align=\"left\">    \n            <input type=radio checked value=男 name=${personSex} style=\"font-size:9pt\">    \n                <font size=2>男</font>    \n            <input type=radio value=女 name=${personSex} style=\"font-size:9pt\">    \n                <font size=2>女</font>    \n        </td>    \n    </tr>    \n    <tr>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\"><DIV style=\"font-size:9pt\">出生日期</DIV></td>     \n        <td align=\"left\">    \n\n                <input type=text name=${birthday} id=${birthday} value=\"${nowDate}\" class=\"Wdate\" size=22 onfocus=\"WdatePicker({dateFmt:'yyyy-MM-dd',maxDate:'%y-%M-@{%d}'})\" />  \n                <FONT color=\"#FF0000\"><Font color=\"\"> *</FONT></FONT>    \n         </td>    \n         <td bgcolor=\"#F4FAFF\" align=\"center\"><DIV style=\"font-size:9pt\">工作经历</DIV></td>    \n         <td align=\"left\">    \n            <select name=${workYears}>    \n                <option value=0 selected>无</option>    \n                <option value=1>一年</option>    \n                <option value=2>二年</option>    \n                <option value=3>三年</option>    \n                <option value=4>四年</option>    \n                <option value=5>五年</option>    \n                <option value=6>六年</option>    \n                <option value=7>七年</option>    \n                <option value=8>八年</option>    \n                <option value=9>九年</option>    \n                <option value=10>十年</option>    \n            </select>    \n        </td>    \n    </tr>    \n    <tr>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">电子邮件</DIV>    \n        </td>    \n        <td align=\"left\">    \n            <input name=\"${email}\" id=\"${email}\" style=\"display: none;\" maxlength=\"50\"><input name=\"${email}_temp\" id=\"${email}_temp\" maxlength=\"50\"><FONT color=\"#FF0000\"> *</FONT>    \n        </td>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">联系方式</DIV> \n        </td>                       \n        <td align=\"left\">    \n            <input  name=\"${contact}\" id=\"${contact}\" style=\"display: none;\" maxlength=\"20\"><input  name=\"${contact}_temp\" id=\"${contact}_temp\" maxlength=\"20\"><FONT color=\"#FF0000\"> *</FONT>\n            \n            <input type=hidden name=${applyDate} id=${applyDate} value=\"${nowDate}\" />\n            <input type='hidden' class=\"text\" name=${graduateDate} value='${nowDate}'>\n            </td>              \n    </tr>    \n    <tr>    \n        <td  bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">外语水平</DIV>    \n        </td>    \n        <td align=\"left\">    \n            <input name=\"${foreignLanguage}\" id=\"${foreignLanguage}\" style=\"display: none;\" maxlength=\"20\"><input name=\"${foreignLanguage}_temp\" id=\"${foreignLanguage}_temp\" maxlength=\"20\"><FONT color=\"#FF0000\"> *</FONT>    \n        </td>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">期望月薪</DIV>    \n        </td>    \n        <td align=\"left\">    \n            <input name=${hopeSalary} maxlength=\"6\"><font size=\"2\">元</font><FONT color=\"#FF0000\"> *</FONT>    \n        </td>    \n    </tr>    \n    <tr>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\">    \n            <DIV style=\"font-size:9pt\">学历</DIV>    \n        </td>    \n        <td align=\"left\">    \n            <select  name=${degree}>    \n                <option value=中学 selected>中学</option>    \n                <option value=中专>中专</option>    \n                <option value=大专>大专</option>    \n                <option value=本科>本科</option>    \n                <option value=硕士>硕士</option>    \n                <option value=博士>博士</option>    \n                <option value=博士后>博士后</option>    \n            </select>    \n        </td>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\" nowrap>    \n            <DIV style=\"font-size:9pt\">专业</DIV>    \n        </td>    \n        <td nowrap align=\"left\">    \n            <input name=\"${specialty}\" id=\"${specialty}\" style=\"display: none;\" maxlength=\"20\"><input name=\"${specialty}_temp\" id=\"${specialty}_temp\" maxlength=\"20\"><FONT color=\"#FF0000\"> *</FONT>    \n        </td>    \n    </tr>    \n    <tr>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\" nowrap>    \n            <DIV style=\"font-size:9pt\">毕业院校</DIV>    \n        </td>    \n        <td nowrap align=\"left\">    \n            <input name=\"${graduateUniversity}\" id=\"${graduateUniversity}\" style=\"display: none;\" maxlength=\"20\"><input name=\"${graduateUniversity}_temp\" id=\"${graduateUniversity}_temp\" maxlength=\"20\"><FONT color=\"#FF0000\"> *</FONT>    \n        </td>    \n        <td bgcolor=\"#F4FAFF\" align=\"center\" nowrap>    \n            <DIV style=\"font-size:9pt\">现居住地</DIV>    \n        </td>    \n        <td nowrap align=\"left\">    \n            <input  name=\"${personAddress}\" id