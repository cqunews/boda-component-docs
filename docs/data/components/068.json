  "template": "<#if searchcode!=''>\n<table  cellpadding=\"5\" cellspacing=\"0\"   width=\"100%\"><tr><td align=\"center\" style=\"font-size: 9pt\">您的查询码为：${searchcode}</td></tr></table>\n<#else>\n<FORM method=\"post\"   enctype=\"multipart/form-data\" action=\"${action}\" id=\"${form}\" name=\"${form}\" onsubmit=\"return _tpladdmsg_sendmessage${uuid}(this)\" style=\"display: inline;\">\n    ${hiddenFiled}\n    <div class=\"govitemcontent{uuid}\" id=\"govitemcontent{uuid}\">\n    <TABLE cellspacing=\"0\" cellpadding=\"3\" width=\"100%\" style=\"background: -moz-linear-gradient(top, #ffffff, #fff5d6);border-collapse:collapse;border:1px #ecc197 solid;FILTER: progid:DXImageTransform.Microsoft.Gradient(GradientType=0,,StartColorStr=#ffffff,, EndColorStr=#fff5d6);\">\n    <#if showselectdept>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                部门\n            </td>\n            <td style=\"border:1px #ecc197 solid;\">\n                <select name=\"${formDept}\">\n                    <#list list_dept as dept>\n                        <option value=\"${dept.code}\" <#if dept.code==deptCode>selected</#if>>${dept.name}</option>\n                    </#list>\n                </select>\n            </td>\n        </tr>\n    <#else>\n    <input type='hidden' name='wbdeptcode' value='${deptCode}'></#if>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                姓名\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formName}\" id=\"${formName}\" maxlength=\"50\" value=\"${name}\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;display: none;\"\n            ><input type=\"text\" name=\"${formName}_temp\" id=\"${formName}_temp\" maxlength=\"50\" value=\"${name}\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                性别\n            </td>\n            <td style=\"border:1px #ecc197 solid;\">\n             <select name=\"${formSex}\">\n                 <option value=\"男\" <#if sex='男'>selected</#if>>男</option>\n                 <option value=\"女\" <#if sex='女'>selected</#if>>女</option>\n             </select>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                身份证号\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formIdcard}\" id=\"${formIdcard}\" value=\"${idCard}\" maxlength=\"20\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                手机\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formTelphone}\" id=\"${formTelphone}\" value=\"${telphone}\" maxlength=\"50\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                联系方式\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formAddress}\" id=\"${formAddress}\" value=\"${address}\" maxlength=\"200\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;display: none;\"\n            ><input type=\"text\" name=\"${formAddress}_temp\" id=\"${formAddress}_temp\" value=\"${address}\" maxlength=\"200\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                固定电话\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formPhone}\" id=\"${formPhone}\" value=\"${phone}\" maxlength=\"50\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                Email\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formEmail}\" id=\"${formEmail}\" value=\"${email}\" maxlength=\"100\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;display: none;\"\n            ><input type=\"text\" name=\"${formEmail}_temp\" id=\"${formEmail}_temp\" value=\"${email}\" maxlength=\"100\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                单位\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formUnit}\" id=\"${formUnit}\" value=\"${unit}\" maxlength=\"100\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;display: none;\"\n            ><input type=\"text\" name=\"${formUnit}_temp\" id=\"${formUnit}_temp\" value=\"${unit}\" maxlength=\"100\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <#if isattach==1>\n        <tr>\n            <td valign=\"top\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                附件\n            </td>\n            <td style=\"border:1px #ecc197 solid;\">\n                <#list list_attach as attach>\n                    <input type=\"file\" name=\"${attach.formAttach}\" id=\"${attach.formAttach}\"><br>\n                </#list>\n            </td>\n        </tr>\n        </#if>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                标题 <span style=\"color: red\">*</span>\n            </td>\n            <td style=\"border:1px #ecc197 solid;\"><input type=\"text\" name=\"${formTitle}\" id=\"${formTitle}\" value=\"${title}\" size=\"50\" maxlength=\"200\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;display: none;\"\n            ><input type=\"text\" name=\"${formTitle}_temp\" id=\"${formTitle}_temp\" value=\"${title}\" size=\"50\" maxlength=\"200\" style=\"BORDER-TOP: #d5d5d5 1px solid;PADDING-BOTTOM: 0px;BORDER-RIGHT: #d5d5d5 1px solid;BORDER-LEFT: #d5d5d5 1px solid;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffff;PADDING-RIGHT: 8px;HEIGHT: 18px;PADDING-TOP: 2px;BORDER-BOTTOM: #d5d5d5 1px solid;\"></td>\n        </tr>\n        <tr>\n            <td style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n                内容 <span style=\"color: red\">*</span>\n            </td>\n            <td style=\"border:1px #ecc197 solid;\">\n                <textarea style=\"display: none;\"  name=\"${formContent}\" id=\"${formContent}\" >${content}</textarea>\n                <textarea    id=\"${formContent}_temp\" rows='10' cols='76'>${content}</textarea>\n            </td>\n        </tr>\n        <tr>\n            <td colspan=\"2\" style=\"border:1px #ecc197 solid;COLOR: #ff6600;FONT-SIZE: 9pt;PADDING-BOTTOM: 3px;PADDING-LEFT: 3px;BACKGROUND-COLOR: #ffffec;PADDING-RIGHT: 3px;FONT-FAMILY: 宋体;FONT-WEIGHT: bold;PADDING-TOP: 3px;\">\n               <#if ischeckcode> <SPAN style=\"FONT-WEIGHT: bold; FONT-SIZE: 9pt; COLOR: #2f7195; TEXT-DECORATION: none\">请输入验证码：</SPAN>\n                <input name=\"${formYanzheng}\" id=\"${formYanzheng}\" type=\"text\" style=\"background-color: #FFFFFF;height: 20px;width: 100px;border: 1px solid #BAD3E6;\" size=\"6\" maxlength=\"4\" /> \n                <img border=\"0\" src=\"${YanzhengImgSrc}\"/></#if>\n                <#if isLogin=='1'>\n                    <#if isSetDept=='1'>\n                        <span>请先设置本栏目绑定的部门</span>\n                    <#else>\n                        <INPUT type=\"submit\" value=\"提交\" style=\"cursor: hand;\">\n                    </#if>\n                <#else>\n                    <span>请先登录</span>\n                </#if>\n            </td>\n        </tr>\n    </TABLE>\n</FORM>\n<script type=\"text/javascript\">\nfunction _tpladdmsg_sendmessage${uuid}(obj)\n{\n    <#if isExistDept>\n         alert(\"提交部门与维护部门不一致,请联系管理员!\");\n         return false;\n    </#if>\n    <#if isSetDept=='1'>\n    if(obj.${formDept})\n    {\n        var wbdeptcode = obj.${formDept}.value;\n        if(wbdeptcode==null||wbdeptcode==\"\"||wbdeptcode==\"-1\")\n        {\n            alert(\"请选择部门!\");\n            return false;\n        }\n    }\n    </#if>\n    if(obj.${formIdcard})\n    {\n        var value = obj.${formIdcard}.value;\n        if(value!=null&&value!=\"\")\n        {\n            var re = /^[0-9][0-9a-z]*$/;\n            if(!re.test(value))\n            {\n                alert(\"身份证号码是15或18位的数字或数字加字母\");\n                obj.${formIdcard}.focus();\n                return false;\n            }\n            if(value.length!=15 && value.length != 18)\n            {\n                alert(\"身份证长度不对\");\n                obj.${formIdcard}.focus();\n                return false;\n            }\n        }\n    }\n    if(obj.${formTelphone})\n    {\n        var wbtelphone = obj.${formTelphone}.value;\n        if(wbtelphone!=\"\"&&wbtelphone!=null)\n        {\n             if(!ValidateUtil.isMobile(wbtelphone))\n             {\n                alert(\"请输入正确的手机号码!\");\n                return false;\n             }\n        }\n    }\n    if(obj.${formPhone})\n    {\n        var wbphone = obj.${formPhone}.value;\n        if(wbphone!=\"\"&&wbphone!=null)\n        {\n           var reg1 =/^\\d{7,8}|\\d{2,5}-\\d{7,8}|\\d{2,5}-\\d{7,8}(-\\d{1,})?$/;\n           if(!reg1.test(wbphone))\n           {\n               alert(\"固定电话可以是7或8位的座机号，可以是000-00000000-000格式的号码\");\n               return false;\n           }\n        }\n    }\n    var email = obj.${formEmail}_temp.value;\n    if(email!=\"\"&&email!=null)\n    {\n        if(!ValidateUtil.isEmail(email))\n        {\n            alert(\"邮箱格式有误!\");\n            return false;\n        }\n    }\n    var wbtitle = obj.${formTitle}_temp.value;\n    wbtitle = trim(wbtitle);\n    if(wbtitle==\"\"||wbtitle==null){\n        alert(\"标题不能为空!\");\n        return false;\n    }\n    \n   var content_temp_value = ValidateUtil.trim(document.getElementById(\"${formContent}_temp\").value);\n   if(content_temp_value==null||content_temp_value==undefined||content_temp_value == \"\")\n    {\n          alert(\"发言内容不能为空!\");\n          return false;\n    }\n\n    if(obj.${formYanzheng})\n    {\n        var yanzheng = obj.${formYanzheng}.value;\n        yanzheng = trim(yanzheng);\n        if(yanzheng==\"\"||yanzheng==null){\n            alert(\"验证码不能为空!\");\n            return false;\n        }\n    }\n    if(document.getElementById(\"${formName}_temp\"))\n    {\n        document.getElementById(\"${formName}\").value=new  Base64().encode(document.getElementById(\"${formName}_temp\").value);\n        document.getElementById(\"${formName}_temp\").disabled=true;\n    }\n    if(document.getElementById(\"${formAddress}_temp\"))\n    {\n        document.getElementById(\"${formAddress}\").value=new  Base64().encode(document.getElementById(\"${formAddress}_temp\").value);\n        document.getElementById(\"${formAddress}_temp\").disabled=true;\n    }\n    if(document.getElementById(\"${formEmail}_temp\"))\n    {\n        document.getElementById(\"${formEmail}\").value=new  Base64().encode(document.getElementById(\"${formEmail}_temp\").value);\n        document.getElementById(\"${formEmail}_temp\").disabled=true;\n    }\n    if(document.getElementById(\"${formUnit}_temp\"))\n    {\n        document.getElementById(\"${formUnit}\").value=new  Base64().encode(document.getElementById(\"${formUnit}_temp\").value);\n        document.getElementById(\"${formUnit}_temp\").disabled=true;\n    }\n    if(document.getElementById(\"${formTitle}_temp\"))\n    {\n        document.getElementById(\"${formTitle}\").value=new  Base64().encode(document.getElementById(\"${formTitle}_temp\").value);\n        document.getElementById(\"${formTitle}_temp\").disabled=true;\n    }\n    document.getElementById(\"${formContent}\").value=new  Base64().encode(document.getElementById(\"${formContent}_temp\").value);\n    document.getElementById(\"${formContent}_temp\").disabled=true;\n    <#if storageOpen >\n       var attachsize = ${attachSize};\n       var needuploadfilesize = 0;\n       for(var i=0;i<attachsize;i++)\n       {  \n           var obj = document.getElementById(\"attach\"+i);\n\t\t   var objv = obj.value;\n\t\t   if(objv.lastIndexOf(\"\\\\\")>0&&objv.lastIndexOf(\",\")>0){\n\t\t\t  var attav = objv.substr(objv.lastIndexOf(\"\\\\\")+1);\n\t\t\t  if(attav.lastIndexOf(\",\")>0){\n\t\t\t \t alert(\"附件名称中不能带有英文逗号!\");\n\t\t\t\t return false;\n\t\t\t  }\n\t\t   }\n           if(obj&&obj.value!=null&&obj.value!=\"\"&&obj.value.length>0)\n           {\n               needuploadfilesize++;  \n           }  \n       }\n       if(needuploadfilesize>0)\n       {\n           //启动云存储调用\n           storage.startStatusCheck();\n           handleshow();\n       }\n    </#if>    \n    return true;\n}\n//显示上传进度\nfunction handleshow()\n{\n    document.getElementById(\"status\").style.display=\"\";\n    document.getElementById(\"govitemcontent{uuid}\").style.display=\"none\";\n}\n//隐藏上传进度\nfunction handlehidden()\n{\n    document.getElementById(\"status\").style.display=\"none\";\n    document.getElementById(\"govitemcontent{uuid}\").style.display=\"\";\n}\n//云存储处理完成后回调的参数\nfunction handlesucceedfunction(json)\n{\n    if(json.file.length>0)\n    { \n        var fileinfo = \"\";\n        for(var i=0;i<json.file.length;i++)\n        {\n             var file = json.file[i];\n             var showname = file.wbshowname;\n             var fileext  = file.wbfileext;\n             var filelength = file.wblength;\n             var shorturl = file.wbshorturl;\n             fileinfo = fileinfo+shorturl+\";\"+showname+\";\"+fileext+\";\"+filelength+\"@\";\n        } \n        document.getElementById(\"wbuploadpath\").value = fileinfo;\n    } \n    storage.recoverForm();\n    if(json.errorinfo==\"\")\n    {\n        document.getElementById('${form}').submit();\n    }\n}\n${storgeFun}\n</script>\n</#if>",
