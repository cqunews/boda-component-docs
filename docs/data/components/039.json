  "template": "<#if newNums!=0 >\n        <table class=listFrame cellspacing=1 cellpadding=0 width=\"100%\"  border=0>\n            <#list newList as list>\n            <tr>\n                <td style=\"line-height:150%\">\n                    <a href=\"${list.url}\" style=\"text-decoration:none\"> <span\n                        style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-WEIGHT: bold; FONT-SIZE: 10pt;text-decor \">\n                            ${list.showTitle} </span> </a>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"line-height:150%\">\n                    <span style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\">${list.content}\n                    </span>\n                </td>\n            </tr>\n            <#if list.showAttach>\n                <tr>\n                <td style=\"line-height:150%\">\n                    <span style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\">${list.attachcontent}\n                    </span>\n                </td>\n            </tr>\n            </#if>\n            <tr>\n                <td style=\"line-height:150%\">\n                    发表时间:<span\n                        style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-WEIGHT: bold; FONT-SIZE: 10pt;\">${list.dateShow}</span>\n                </td>\n            </tr>\n            <tr>\n                <td>\n                    <br>\n                </td>\n            </tr>\n            </#list>\n        </table>\n        <#if number<newNums>\n            <table class=listFrame cellspacing=1 cellpadding=0 border=0\n                width=\"100%\">\n                <tr>\n                    <td align=\"center\">\n                        共有 ${newNums} 条&nbsp;&nbsp;\n                        <#if 1<currentpage><a ${firstpageurl}> 首页</a><#else> 首页</#if> &nbsp;&nbsp;&nbsp;&nbsp;\n        \n                        <#if 1<currentpage><a ${priurl}>上一页</a><#else>上一页</#if> &nbsp;&nbsp;&nbsp;&nbsp;\n        \n                        <#if currentpage<totlepages><a ${nexturl}>下一页</a><#else>下一页</#if> &nbsp;&nbsp;&nbsp;&nbsp;\n                        <#if currentpage<totlepages><a ${lastpageurl}>尾页</a><#else>尾页</#if>&nbsp;&nbsp; 共有 ${totlepages}\n                        页&nbsp;&nbsp; 当前第 ${currentpage} 页\n                    </td>\n                </tr>\n            </table>\n            </#if>\n        <#else>\n            <table style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\"\n                cellspacing=1 cellpadding=0 border=0 width=\"100%\">\n                <tr>\n                    <td>\n                        找不到和您的查询内容相符的内容。\n                        <br>\n                        <br>\n                    </td>\n                </tr>\n                <tr>\n                    <td>\n                        建议:\n                    </td>\n                </tr>\n                <tr>\n                    <td>\n                        <ul>\n                            &nbsp;&nbsp;&nbsp;&nbsp;\n                            <li>请检查输入字词有无错误。</li>\n                            <li>请换用另外的查询字词。</li>\n                            <li>请改用较常见的字词。</li>\n                        </ul>\n                    </td>\n                </tr>\n            </table></#if>\n",
