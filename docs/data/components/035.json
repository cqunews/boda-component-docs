  "template": "<script type=\"text/javascript\">\n     function checksearch${UUID}()\n     { \n            var keyword = document.getElementById(\"newskeycode${viewid}\").value \n            if(keyword==null||keyword==\"\")\n            { \n            alert(\"请输入你要检索的内容！\"); \n            return false; \n            } \n            if(window.toFF==1) \n            { \n            document.getElementById(\"newskeycode2${viewid}\").value = Simplized(keyword ); \n            }\n            else \n            { \n            document.getElementById(\"newskeycode2${viewid}\").value = keyword; \n            } \n            document.getElementById('_lucenesearchtype${viewid}').value=2; \n            var base64 = new Base64(); \n            document.getElementById(\"newskeycode2${viewid}\").value=base64.encode(document.getElementById(\"newskeycode2${viewid}\").value); \n            document.getElementById(\"newskeycode${viewid}\").disabled=true; return true; } </script> \n            <form action=\"${actionURL}\" method=\"post\" name=\"${formName}\" onsubmit=\"return checksearch${UUID}()\">\n                 ${hidden}\n                  <table class=listFrame cellspacing=1 cellpadding=0 width=\"100%\" border=0>\n                     <tr> \n                        <td align=\"left\" nowrap=\"nowrap\"> \n                            <input size='25' name='${newskeycode}' id=\"${newskeycodeid}\" style=\"COLOR: #222222; FONT-SIZE: 10pt; BORDER-TOP: #878787 1px solid; BORDER-RIGHT: #878787 1px solid; BORDER-LEFT: #878787 1px solid; PADDING-LEFT: 20px; BACKGROUND-IMAGE: url(/system/resource/images/research/seach_bg.gif); FONT-FAMILY: 宋体; HEIGHT: 22px; POSITION: relative; BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM: #878787 1px solid; PADDING-TOP: 3px;\" value=\"${invalue}\"> \n                                <input type=image src=\"/system/resource/images/research/seach22.gif\" align=\"absmiddle\" style=\"cursor: hand;\" /> \n                                </td> \n                                </tr> \n                                </table> \n                                </form>\n                                 <#if newNums!=0 > \n                                        <table class=listFrame cellspacing=1 cellpadding=0 width=\"100%\" border=0> \n                                            <input type='hidden' name='newskeycode' value=\"${invalue}\"> \n                                                <#list newList as list> \n                                                    <tr> \n                                                        <td>\n                                                             <a href=\"${list.url}\" style=\"text-decoration:none\">\n                                                                 <span style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-WEIGHT: bold; FONT-SIZE: 10pt;text-decor \"> \n                                                                    ${list.showTitle}\n                                                                    </span>\n                                                                </a>\n                                                            </td>\n                                                     </tr>\n                                             <tr>\n                                             <td> \n                                            <span style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\">${list.content} </span> </td> </tr> <tr> <td> \n                                        <span style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\">${list.attachcontent} </span> </td> </tr> <tr> <td> 发表时间:<span style=\"COLOR: #333333; FONT-FAMILY: 宋体; FONT-WEIGHT: bold; FONT-SIZE: 10pt;\">${list.dateShow}</span> </td> </tr> <tr> <td> <br> </td> </tr> </#list> </table> <#if number<newNums> <table class=listFrame cellspacing=1 cellpadding=0 border=0 width=\"100%\"> <tr> <td align=\"center\"> 共有 ${newNums} 条&nbsp;&nbsp; <#if 1<currentpage><a href=\"${firstpageurl}\"> 首页</a><#else> 首页</#if> &nbsp;&nbsp;&nbsp;&nbsp; <#if 1<currentpage><a href=\"${priurl}\">上一页</a><#else>上一页</#if> &nbsp;&nbsp;&nbsp;&nbsp; <#if currentpage<totlepages><a href=\"${nexturl}\">下一页</a><#else>下一页</#if> &nbsp;&nbsp;&nbsp;&nbsp; <#if currentpage<totlepages><a href=\"${lastpageurl}\">尾页</a><#else>尾页</#if>&nbsp;&nbsp; 共有 ${totlepages} 页&nbsp;&nbsp; 当前第 ${currentpage} 页 </td> </tr> </table> </#if> <#else> <table style=\"FONT-FAMILY: 宋体; COLOR: #222222; FONT-SIZE: 9pt;\" cellspacing=1 cellpadding=0 border=0 width=\"100%\"> <tr> <td> 找不到和您的查询&nbsp;\" <B> ${invalue} </B> \" &nbsp;相符的新闻。 <br> <br> </td> </tr> <tr> <td> 建议: </td> </tr> <tr> <td> <ul> &nbsp;&nbsp;&nbsp;&nbsp; <li> 请检查输入字词有无错误。</li><li> 请换用另外的查询字词。</li><li> 请改用较常见的字词。</li> </ul> </td> </tr> </table> \n                                            </#if> ",
