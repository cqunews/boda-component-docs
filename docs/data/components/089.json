  "template": "<#if issucess>\n    <script type=\"text/javascript\">\n        alert(\"投票成功\"); \n    </script>\n<#else>\n    <script type=\"text/javascript\">\n        <#if resultmsg!='' >\n        alert(\"${resultmsg}\"); \n        </#if>\n    </script>\n</#if>\n<form name=\"${formname}\" id=\"${formname}\" method=\"post\" action=\"${action}\" style=\"display: inline;\" >\n${hidden}\n    <table  cellspacing=\"0\" cellpadding=\"3\" width=\"100%\" border=\"0\" style=\"word-break:break-all;COLOR: #ffffff;FONT-FAMILY: 宋体;BACKGROUND-IMAGE: url(/system/resource/images/leadermail/xjdc_bg.jpg);FONT-WEIGHT: bold;WIDTH: 647px;POSITION: relative;HEIGHT: 32px;FONT-SIZE: 9pt;border-collapse: collapse; border:0px black solid;\">\n        <tr>\n            <td nowrap=\"nowrap\" align=\"left\"  style=\"BACKGROUND-IMAGE: url(/system/resource/images/leadermail/xjdc_bg.jpg);PADDING-LEFT: 35px;border:0px black solid;\" >\n            \n            <span >${title}</span>\n                <#list list_xx as list>\n                <input type=\"radio\" name=\"${list.name}\"  id=\"${list.id}\" value=\"${list.code}\">\n                <label for=\"${list.id}\"><span >${list.showtitle}</span></label>\n                </#list>\n                \n            </td>\n            <td align=\"absmiddle\" style=\"vertical-align: right;border:0px black   solid;\"><input type=image src=\"/system/resource/images/leadermail/xjdc_anniu_tp.jpg\" valign=\"bottom\" style=\"cursor: hand\"  \n                ></td>\n        </tr>\n     </table>\n        \n     <#if isshowresult>\n        <table  cellspacing=\"0\" cellpadding=\"3\" width=\"100%\" border=\"0\" style=\"word-break:break-all;WIDTH: 647px;POSITION: relative;HEIGHT: 32px;\">\n            <tr>\n                <td nowrap=\"nowrap\"  align=\"left\" style=\"border:0px black   solid;BACKGROUND-IMAGE: url(/system/resource/images/leadermail/xjdc_xuanxiang_bg.gif);PADDING-LEFT: 35px;WIDTH: 647px;POSITION: relative;HEIGHT: 54px; \">\n                    <span  style=\"FONT-FAMILY: 宋体;FONT-SIZE: 9pt; \" >当前投票结果：</span>\n                    <#list list_result as list_result>\n                    <span  style=\"FONT-FAMILY: 宋体;COLOR: #3c3c3c;FONT-SIZE: 9pt;\" >${list_result.title}</span><span  style=\"FONT-FAMILY: 宋体;COLOR: #b52907;FONT-SIZE: 9pt;\" > ${list_result.votecount} 票(${list_result.parresult})</span>&nbsp;&nbsp;\n                    </#list>\n                    \n                </td>\n            </tr>\n        </table>\n    </#if>\n    ${hidden2}\n\n</form>",
